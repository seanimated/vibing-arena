-- ============================================================================
-- 4. SCRAPER JOBS (log of each bot run)
-- ============================================================================

CREATE TABLE IF NOT EXISTS scraper_jobs (
    id                  INT AUTO_INCREMENT PRIMARY KEY,
    source_id           INT          NOT NULL,
    job_uid             VARCHAR(64)  UNIQUE NOT NULL,   -- UUID assigned by bot at job start
    status              VARCHAR(20)  DEFAULT 'Running', -- Running | Completed | Failed | Cancelled
    triggered_by        VARCHAR(20)  DEFAULT 'cron',   -- cron | manual | webhook
    triggered_by_admin  INT          DEFAULT NULL,      -- if manual
    started_at          TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
    finished_at         TIMESTAMP    NULL,
    duration_seconds    INT          DEFAULT NULL,
    pages_scraped       INT          DEFAULT 0,
    tenders_found       INT          DEFAULT 0,
    tenders_new         INT          DEFAULT 0,         -- newly inserted (not duplicates)
    tenders_updated     INT          DEFAULT 0,
    pdfs_downloaded     INT          DEFAULT 0,
    error_count         INT          DEFAULT 0,
    error_log           TEXT         DEFAULT NULL,      -- JSON array of error messages
    raw_response_sample TEXT         DEFAULT NULL,      -- first 2000 chars of raw HTML/JSON (for debugging)
    user_agent          VARCHAR(255) DEFAULT NULL,
    ip_used             VARCHAR(45)  DEFAULT NULL,
    FOREIGN KEY (source_id)           REFERENCES scraper_sources(id) ON DELETE CASCADE,
    FOREIGN KEY (triggered_by_admin)  REFERENCES admins(id) ON DELETE SET NULL
);

