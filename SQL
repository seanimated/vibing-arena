-- Admin panel dashboard stats
DROP VIEW IF EXISTS v_dashboard_stats;
CREATE VIEW v_dashboard_stats AS
SELECT
    (SELECT COUNT(*) FROM raw_tenders WHERE admin_status = 'Pending')              AS pending_tenders,
    (SELECT COUNT(*) FROM raw_tenders WHERE admin_status = 'Under Review')         AS under_review,
    (SELECT COUNT(*) FROM raw_tenders WHERE admin_status = 'Approved')             AS approved_today,
    (SELECT COUNT(*) FROM published_tenders WHERE status = 'Active')               AS live_tenders,
    (SELECT COUNT(*) FROM published_tenders WHERE closing_date < CURDATE()
        AND status = 'Active')                                                      AS expired_not_closed,
    (SELECT COUNT(*) FROM scraper_jobs WHERE status = 'Running')                   AS scrapers_running,
    (SELECT COUNT(*) FROM scraper_jobs WHERE status = 'Failed'
        AND DATE(started_at) = CURDATE())                                           AS scraper_failures_today,
    (SELECT COUNT(*) FROM raw_tenders WHERE DATE(scraped_at) = CURDATE())          AS tenders_scraped_today,
    (SELECT COUNT(*) FROM tender_applications WHERE DATE(submitted_at) = CURDATE()) AS applications_today,
    (SELECT COUNT(*) FROM applicants WHERE is_active = TRUE)                        AS total_applicants,
    (SELECT COUNT(*) FROM access_requests WHERE status = 'Pending')                AS pending_access_requests,
    (SELECT COUNT(*) FROM raw_tenders WHERE is_duplicate = TRUE
        AND DATE(scraped_at) = CURDATE())                                           AS duplicates_today;

-- Raw tender inbox view (operations page)
DROP VIEW IF EXISTS v_raw_tender_inbox;
CREATE VIEW v_raw_tender_inbox AS
SELECT
    rt.id,
    rt.admin_status,
    rt.title,
    rt.reference_number,
    rt.issuing_organisation,
    rt.province,
    rt.tender_type,
    rt.estimated_value,
    rt.currency,
    rt.closing_date,
    rt.published_date,
    rt.cidb_grade,
    rt.bbbee_requirement,
    rt.is_duplicate,
    rt.source_url,
    rt.scraped_at,
    rt.admin_notes,
    ss.name                                             AS source_name,
    ss.base_url                                         AS source_base_url,
    sj.job_uid                                          AS scraper_job_uid,
    CONCAT(aa.first_name,' ',aa.last_name)              AS assigned_to_name,
    CONCAT(ra.first_name,' ',ra.last_name)              AS reviewed_by_name,
    rt.reviewed_at,
    -- Count of PDFs attached
    (SELECT COUNT(*) FROM tender_files tf
     WHERE tf.raw_tender_id = rt.id AND tf.is_active = TRUE)    AS pdf_count,
    -- Days until closing
    DATEDIFF(rt.closing_date, CURDATE())                AS days_until_closing,
    CASE
        WHEN rt.closing_date < CURDATE() THEN TRUE ELSE FALSE
    END AS is_expired
FROM raw_tenders rt
JOIN scraper_sources ss ON rt.source_id = ss.id
LEFT JOIN scraper_jobs sj ON rt.scraper_job_id = sj.id
LEFT JOIN admins aa ON rt.assigned_to = aa.id
LEFT JOIN admins ra ON rt.reviewed_by = ra.id
ORDER BY rt.scraped_at DESC;

