-- ============================================================================
-- 5. RAW SCRAPED TENDERS (bot inbox — unreviewed)
-- ============================================================================

CREATE TABLE IF NOT EXISTS raw_tenders (
    id                      INT AUTO_INCREMENT PRIMARY KEY,
    scraper_job_id          INT          DEFAULT NULL,
    source_id               INT          NOT NULL,

    -- Identifiers
    source_tender_id        VARCHAR(255) DEFAULT NULL,   -- ID as it appears on the source site
    source_url              VARCHAR(1000) NOT NULL,      -- direct URL to this tender on source site
    content_hash            VARCHAR(64)  DEFAULT NULL,   -- SHA-256 of title+desc to detect duplicates

    -- Core tender data (as scraped — may be raw/dirty)
    title                   VARCHAR(1000) NOT NULL,
    reference_number        VARCHAR(255) DEFAULT NULL,
    description             TEXT         DEFAULT NULL,
    issuing_organisation    VARCHAR(500) DEFAULT NULL,
    province                VARCHAR(100) DEFAULT NULL,
    tender_type             VARCHAR(100) DEFAULT NULL,   -- Goods | Services | Works | Consultancy | Other
    estimated_value         DECIMAL(18,2) DEFAULT NULL,
    currency                VARCHAR(3)   DEFAULT 'ZAR',
    closing_date            DATE         DEFAULT NULL,
    closing_time            TIME         DEFAULT NULL,
    published_date          DATE         DEFAULT NULL,
    compulsory_briefing     BOOLEAN      DEFAULT FALSE,
    briefing_date           DATE         DEFAULT NULL,
    briefing_venue          TEXT         DEFAULT NULL,
    briefing_address_one    VARCHAR(500) DEFAULT NULL,          -- Briefing Address One (falls back to briefing_venue)
    briefing_address_two    VARCHAR(500) DEFAULT NULL,          -- Briefing Address Two
    briefing_address_city   VARCHAR(255) DEFAULT NULL,          -- Briefing Address City
    briefing_address_postal_code VARCHAR(20) DEFAULT NULL,      -- Briefing Address Postal Code
    contact_name            VARCHAR(255) DEFAULT NULL,
    contact_email           VARCHAR(255) DEFAULT NULL,
    contact_phone           VARCHAR(50)  DEFAULT NULL,
    enquiries_email         VARCHAR(255) DEFAULT NULL,
    submission_address      TEXT         DEFAULT NULL,          -- Submission Address One
    submission_address_two  VARCHAR(500) DEFAULT NULL,          -- Submission Address Two
    submission_address_city VARCHAR(255) DEFAULT NULL,          -- Submission Address City
    submission_address_postal_code VARCHAR(20) DEFAULT NULL,    -- Submission Address Postal Code

    -- CIDB / B-BBEE requirements
    cidb_grade              VARCHAR(20)  DEFAULT NULL,   -- e.g. '5CE', '7GB'
    bbbee_requirement       VARCHAR(50)  DEFAULT NULL,   -- e.g. 'Level 1', 'Level 4+', NULL = not specified
    local_content_pct       DECIMAL(5,2) DEFAULT NULL,   -- % local content required

    -- Raw HTML captured from source (kept for re-parsing)
    raw_html_snippet        MEDIUMTEXT   DEFAULT NULL,

    -- Admin workflow
    admin_status            VARCHAR(30)  DEFAULT 'Pending',
    -- Pending | Under Review | Approved | Rejected | Duplicate | Pushed
    is_duplicate            BOOLEAN      DEFAULT FALSE,
    duplicate_of_id         INT          DEFAULT NULL,   -- FK to self
    assigned_to             INT          DEFAULT NULL,   -- admin reviewing this
    assigned_at             TIMESTAMP    NULL,
    admin_notes             TEXT         DEFAULT NULL,   -- reviewer notes

    -- Timestamps
    scraped_at              TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
    reviewed_at             TIMESTAMP    NULL,
    reviewed_by             INT          DEFAULT NULL,

    UNIQUE KEY unique_source_tender (source_id, source_tender_id),

    FOREIGN KEY (scraper_job_id) REFERENCES scraper_jobs(id) ON DELETE SET NULL,
    FOREIGN KEY (source_id)      REFERENCES scraper_sources(id),
    FOREIGN KEY (assigned_to)    REFERENCES admins(id) ON DELETE SET NULL,
    FOREIGN KEY (reviewed_by)    REFERENCES admins(id) ON DELETE SET NULL
);

