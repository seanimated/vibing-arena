-- ── NTS auth token storage ────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS nts_auth_tokens (
    id               INT AUTO_INCREMENT PRIMARY KEY,
    access_token     TEXT         NOT NULL,
    refresh_token    TEXT         NOT NULL,
    access_expires   TIMESTAMP    NOT NULL,   -- 20 min from issue
    refresh_expires  TIMESTAMP    NOT NULL,   -- 30 days from issue
    created_at       TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
    updated_at       TIMESTAMP    DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- ── NTS push batches (one row per batch_reference submitted to NTS API) ───────
CREATE TABLE IF NOT EXISTS nts_push_batches (
    id               INT AUTO_INCREMENT PRIMARY KEY,
    batch_reference  VARCHAR(100) UNIQUE NOT NULL,
    pushed_by        INT          DEFAULT NULL,
    status           VARCHAR(30)  DEFAULT 'Pending',
    -- Pending | Completed | PartialFail | Failed
    total            INT          DEFAULT 0,
    successful       INT          DEFAULT 0,
    duplicates       INT          DEFAULT 0,
    failed           INT          DEFAULT 0,
    http_status_code INT          DEFAULT NULL,
    raw_response     MEDIUMTEXT   DEFAULT NULL,
    pushed_at        TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (pushed_by) REFERENCES admins(id) ON DELETE SET NULL
);

-- ── NTS push results (one row per tender per batch) ───────────────────────────
CREATE TABLE IF NOT EXISTS nts_push_results (
    id                   INT AUTO_INCREMENT PRIMARY KEY,
    batch_id             INT          NOT NULL,
    published_tender_id  INT          DEFAULT NULL,
    tender_number        VARCHAR(255) DEFAULT NULL,
    status               VARCHAR(30)  DEFAULT NULL,
    -- success | duplicate | failed
    nts_uid              VARCHAR(255) DEFAULT NULL,
    message              TEXT         DEFAULT NULL,
    created_at           TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (batch_id)            REFERENCES nts_push_batches(id)  ON DELETE CASCADE,
    FOREIGN KEY (published_tender_id) REFERENCES published_tenders(id) ON DELETE SET NULL
);

