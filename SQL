-- ============================================================================
-- 6. TENDER FILES (PDFs and other documents)
-- ============================================================================

CREATE TABLE IF NOT EXISTS tender_files (
    id                  INT AUTO_INCREMENT PRIMARY KEY,
    raw_tender_id       INT          DEFAULT NULL,  -- linked to raw (pre-approval)
    published_tender_id INT          DEFAULT NULL,  -- linked to published (post-approval)
    file_type           VARCHAR(30)  DEFAULT 'tender_document',
    -- tender_document | addendum | clarification | award_notice | other

    -- Scraper-downloaded file
    original_url        VARCHAR(1000) DEFAULT NULL,  -- URL it was downloaded from
    file_name           VARCHAR(500) NOT NULL,
    stored_path         VARCHAR(1000) NOT NULL,      -- relative path on disk e.g. storage/pdfs/2025/06/uuid.pdf
    file_size_bytes     BIGINT       DEFAULT NULL,
    mime_type           VARCHAR(100) DEFAULT 'application/pdf',
    page_count          INT          DEFAULT NULL,   -- extracted from PDF metadata
    is_searchable       BOOLEAN      DEFAULT NULL,   -- TRUE if text-extractable, FALSE if scanned image
    extracted_text      LONGTEXT     DEFAULT NULL,   -- text extracted from PDF for full-text search

    -- Upload meta
    download_status     VARCHAR(20)  DEFAULT 'Downloaded',  -- Downloaded | Failed | Pending
    downloaded_at       TIMESTAMP    NULL,
    download_error      TEXT         DEFAULT NULL,

    -- Admin uploads (manual additions)
    uploaded_by_admin   INT          DEFAULT NULL,
    uploaded_at         TIMESTAMP    NULL,

    is_active           BOOLEAN      DEFAULT TRUE,
    created_at          TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (raw_tender_id)       REFERENCES raw_tenders(id) ON DELETE CASCADE,
    FOREIGN KEY (uploaded_by_admin)   REFERENCES admins(id) ON DELETE SET NULL
);

