-- ============================================================================
-- 8. PUBLISHED TENDERS (admin-approved, visible to applicants in the app)
-- ============================================================================

CREATE TABLE IF NOT EXISTS published_tenders (
    id                      INT AUTO_INCREMENT PRIMARY KEY,
    raw_tender_id           INT          NOT NULL,   -- source raw record

    -- Cleaned / edited core data (may differ from raw after admin edits)
    title                   VARCHAR(1000) NOT NULL,
    reference_number        VARCHAR(255) DEFAULT NULL,
    slug                    VARCHAR(1000) GENERATED ALWAYS AS (
                                LOWER(REPLACE(REPLACE(SUBSTRING(title, 1, 200), ' ', '-'), '/', '-'))
                            ) STORED,
    description             LONGTEXT     NOT NULL,
    category_id             INT          DEFAULT NULL,
    issuing_organisation    VARCHAR(500) DEFAULT NULL,
    province                VARCHAR(100) DEFAULT NULL,
    tender_type             VARCHAR(100) DEFAULT NULL,
    estimated_value         DECIMAL(18,2) DEFAULT NULL,
    currency                VARCHAR(3)   DEFAULT 'ZAR',
    closing_date            DATE         NOT NULL,
    closing_time            TIME         DEFAULT '17:00:00',
    published_date          DATE         DEFAULT NULL,   -- date on original source
    compulsory_briefing     BOOLEAN      DEFAULT FALSE,
    briefing_date           DATE         DEFAULT NULL,
    briefing_venue          TEXT         DEFAULT NULL,
    briefing_address_one    VARCHAR(500) DEFAULT NULL,   -- Briefing Address One (falls back to briefing_venue)
    briefing_address_two    VARCHAR(500) DEFAULT NULL,   -- Briefing Address Two
    briefing_address_city   VARCHAR(255) DEFAULT NULL,   -- Briefing Address City
    briefing_address_postal_code VARCHAR(20) DEFAULT NULL, -- Briefing Address Postal Code
    contact_name            VARCHAR(255) DEFAULT NULL,
    contact_email           VARCHAR(255) DEFAULT NULL,
    contact_phone           VARCHAR(50)  DEFAULT NULL,
    enquiries_email         VARCHAR(255) DEFAULT NULL,
    submission_address      TEXT         DEFAULT NULL,   -- Submission Address One
    submission_address_two  VARCHAR(500) DEFAULT NULL,   -- Submission Address Two
    submission_address_city VARCHAR(255) DEFAULT NULL,   -- Submission Address City
    submission_address_postal_code VARCHAR(20) DEFAULT NULL, -- Submission Address Postal Code
    cidb_grade              VARCHAR(20)  DEFAULT NULL,
    bbbee_requirement       VARCHAR(50)  DEFAULT NULL,
    local_content_pct       DECIMAL(5,2) DEFAULT NULL,
    source_url              VARCHAR(1000) DEFAULT NULL,

    -- Portal status
    status                  VARCHAR(30)  DEFAULT 'Active',
    -- Active | Closed | Cancelled | Awarded | Archived
    is_featured             BOOLEAN      DEFAULT FALSE,
    is_urgent               BOOLEAN      DEFAULT FALSE,
    view_count              INT          DEFAULT 0,
    application_count       INT          DEFAULT 0,   -- denormalised counter

    -- Approval meta
    approved_by             INT          NOT NULL,
    approved_at             TIMESTAMP    NOT NULL,
    published_at            TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
    last_edited_by          INT          DEFAULT NULL,
    last_edited_at          TIMESTAMP    NULL,

    -- Expiry
    expires_at              TIMESTAMP    GENERATED ALWAYS AS (
                                TIMESTAMP(closing_date, closing_time)
                            ) STORED,

    created_at              TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
    updated_at              TIMESTAMP    DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    FOREIGN KEY (raw_tender_id)    REFERENCES raw_tenders(id),
    FOREIGN KEY (category_id)      REFERENCES tender_categories(id) ON DELETE SET NULL,
    FOREIGN KEY (approved_by)      REFERENCES admins(id),
    FOREIGN KEY (last_edited_by)   REFERENCES admins(id) ON DELETE SET NULL
);

-- Many-to-many: published_tenders ↔ tender_tags
CREATE TABLE IF NOT EXISTS published_tender_tags (
    published_tender_id INT NOT NULL,
