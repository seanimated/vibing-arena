-- Auto-update published_tenders.application_count when an application is inserted
DROP TRIGGER IF EXISTS trg_app_insert_count;
DELIMITER $$
CREATE TRIGGER trg_app_insert_count
AFTER INSERT ON tender_applications
FOR EACH ROW
BEGIN
    UPDATE published_tenders
    SET application_count = application_count + 1
    WHERE id = NEW.published_tender_id;
END$$
DELIMITER ;

-- Auto-update published_tenders.application_count when an application is withdrawn
DROP TRIGGER IF EXISTS trg_app_withdraw_count;
DELIMITER $$
CREATE TRIGGER trg_app_withdraw_count
AFTER UPDATE ON tender_applications
FOR EACH ROW
BEGIN
    IF NEW.is_withdrawn = TRUE AND OLD.is_withdrawn = FALSE THEN
        UPDATE published_tenders
        SET application_count = GREATEST(application_count - 1, 0)
        WHERE id = NEW.published_tender_id;
    END IF;
END$$
DELIMITER ;

-- Auto-close published tenders past their closing date (called by cron procedure)
DROP PROCEDURE IF EXISTS sp_close_expired_tenders;
DELIMITER $$
CREATE PROCEDURE sp_close_expired_tenders()
BEGIN
    UPDATE published_tenders
    SET status = 'Closed',
        updated_at = CURRENT_TIMESTAMP
    WHERE status = 'Active'
      AND closing_date < CURDATE();
END$$
DELIMITER ;

-- Auto-update scraper source last_scraped_at when a job completes
DROP TRIGGER IF EXISTS trg_job_complete_source;
DELIMITER $$
CREATE TRIGGER trg_job_complete_source
AFTER UPDATE ON scraper_jobs
FOR EACH ROW
BEGIN
    IF NEW.status IN ('Completed', 'Failed') AND OLD.status = 'Running' THEN
        UPDATE scraper_sources
        SET last_scraped_at = NEW.finished_at,
            scrape_count    = scrape_count + IF(NEW.status = 'Completed', 1, 0),
            last_error      = IF(NEW.status = 'Failed', NEW.error_log, NULL)
        WHERE id = NEW.source_id;
    END IF;
END$$
DELIMITER ;

