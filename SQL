-- ============================================================================
-- 3. SCRAPER SOURCES (websites the bot scrapes)
-- ============================================================================

CREATE TABLE IF NOT EXISTS scraper_sources (
    id                  INT AUTO_INCREMENT PRIMARY KEY,
    name                VARCHAR(255) NOT NULL,           -- e.g. 'eTenders South Africa'
    base_url            VARCHAR(500) NOT NULL,           -- e.g. 'https://www.etenders.gov.za'
    tender_list_url     VARCHAR(500) DEFAULT NULL,       -- URL of the listing page
    scraper_type        VARCHAR(50)  DEFAULT 'html',     -- html | api | pdf | rss
    scraper_class       VARCHAR(100) DEFAULT NULL,       -- PHP class name handling this source
    auth_required       BOOLEAN      DEFAULT FALSE,
    auth_credentials    JSON         DEFAULT NULL,       -- encrypted credentials if needed
    request_interval_s  INT          DEFAULT 3600,       -- seconds between scrape runs
    is_active           BOOLEAN      DEFAULT TRUE,
    is_verified         BOOLEAN      DEFAULT FALSE,      -- source has been tested and confirmed working
    last_scraped_at     TIMESTAMP    NULL,
    last_error          TEXT         DEFAULT NULL,
    scrape_count        INT          DEFAULT 0,          -- total successful scrapes
    logo_url            VARCHAR(500) DEFAULT NULL,
    notes               TEXT,
    created_at          TIMESTAMP    DEFAULT CURRENT_TIMESTAMP,
    updated_at          TIMESTAMP    DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    created_by          INT,
    FOREIGN KEY (created_by) REFERENCES admins(id) ON DELETE SET NULL
);

